generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum PeriodStatus {
  OPEN
  CLOSED
  LOCKED
}

enum PeriodLockAction {
  LOCK
  UNLOCK
}

model Account {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  code           String
  name           String
  type           AccountType
  currency       String       @db.Char(3)
  parentId       String?      @map("parent_id") @db.Uuid
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @default(now()) @map("updated_at") @db.Timestamptz(6)

  journalLines   JournalLine[]
  invoiceLines   InvoiceLine[]
  creditNoteLines CreditNoteLine[]
  parent         Account?     @relation("AccountHierarchy", fields: [parentId], references: [id])
  children       Account[]    @relation("AccountHierarchy")

  @@unique([organizationId, code])
  @@index([organizationId, type])
  @@map("accounts")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
}

model AccountingConfig {
  id                   String       @id @default(uuid()) @db.Uuid
  organizationId       String       @map("organization_id") @db.Uuid
  baseCurrency         String       @map("base_currency") @db.Char(3)
  fiscalYearStartMonth Int          @map("fiscal_year_start_month")
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime     @updatedAt @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([organizationId])
  @@map("accounting_configs")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
}

model Period {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String
  startDate      DateTime     @map("start_date") @db.Date
  endDate        DateTime     @map("end_date") @db.Date
  status         PeriodStatus @default(OPEN)
  lockedAt       DateTime?    @map("locked_at") @db.Timestamptz(6)
  lockedBy       String?      @map("locked_by") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @default(now()) @map("updated_at") @db.Timestamptz(6)

  journalEntries JournalEntry[]
  periodLocks    PeriodLock[]

  @@unique([organizationId, name])
  @@index([organizationId, status])
  @@map("periods")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
}

model PeriodLock {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  periodId       String         @map("period_id") @db.Uuid
  action         PeriodLockAction
  reason         String
  actorId        String         @map("actor_id") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  period         Period         @relation(fields: [periodId], references: [id])

  @@index([organizationId, periodId])
  @@map("period_locks")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
}

model JournalEntry {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  periodId       String       @map("period_id") @db.Uuid
  journalNumber  Int?         @map("journal_number")
  entryDate      DateTime     @map("entry_date") @db.Date
  description    String
  sourceModule   String       @map("source_module") @default("manual")
  sourceId       String?      @map("source_id")
  currency       String       @db.Char(3)
  postedAt       DateTime?    @map("posted_at") @db.Timestamptz(6)
  postedBy       String?      @map("posted_by") @db.Uuid
  reversalOfId   String?      @map("reversal_of_id") @db.Uuid
  reversedById   String?      @map("reversed_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @default(now()) @map("updated_at") @db.Timestamptz(6)

  journalLines   JournalLine[]
  period         Period       @relation(fields: [periodId], references: [id])

  @@unique([organizationId, periodId, journalNumber])
  @@index([organizationId, periodId])
  @@index([organizationId, postedAt])
  @@map("journal_entries")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
}

model JournalLine {
  id              String        @id @default(uuid()) @db.Uuid
  organizationId  String        @map("organization_id") @db.Uuid
  journalEntryId  String        @map("journal_entry_id") @db.Uuid
  accountId       String        @map("account_id") @db.Uuid
  lineNumber      Int           @map("line_number")
  debit           Decimal       @default(0) @db.Decimal(18, 4)
  credit          Decimal       @default(0) @db.Decimal(18, 4)
  currency        String        @db.Char(3)
  fxRate          Decimal       @default(1) @map("fx_rate") @db.Decimal(18, 8)
  reportingAmount Decimal       @map("reporting_amount") @db.Decimal(18, 4)
  memo            String?
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  journalEntry    JournalEntry  @relation(fields: [journalEntryId], references: [id])
  account         Account       @relation(fields: [accountId], references: [id])

  @@unique([journalEntryId, lineNumber])
  @@index([organizationId, accountId])
  @@map("journal_lines")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
}

model JournalCounter {
  organizationId String       @map("organization_id") @db.Uuid
  periodId       String       @map("period_id") @db.Uuid
  lastNumber     Int          @map("last_number") @default(0)
  updatedAt      DateTime     @updatedAt @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@id([organizationId, periodId])
  @@map("journal_counters")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  actorId        String   @map("actor_id") @db.Uuid
  action         String
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id") @db.Uuid
  before         Json?
  after          Json?
  requestId      String?  @map("request_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
  @@map("audit_logs")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
}

// ── Tenancy and identity (AUTH-TENANCY) ─────────────────────────────
// Added so the ledger's organization_id can carry a real foreign key.
// Closes B-20260911-02.

enum MembershipRole {
  VIEWER
  BOOKKEEPER
  APPROVER
  ACCOUNTANT
  ADMIN
  OWNER
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @default(now()) @map("updated_at") @db.Timestamptz(6)

  memberships Membership[]
  accounts Account[]
  accountingConfigs AccountingConfig[]
  periods Period[]
  periodLocks PeriodLock[]
  journalEntries JournalEntry[]
  journalLines JournalLine[]
  journalCounters JournalCounter[]
  auditLogs AuditLog[]
  salesInvoiceCounters SalesInvoiceCounter[]
  salesPaymentCounters SalesPaymentCounter[]
  salesCreditNoteCounters SalesCreditNoteCounter[]
  customers Customer[]
  invoices Invoice[]
  invoiceLines InvoiceLine[]
  customerPayments CustomerPayment[]
  paymentAllocations PaymentAllocation[]
  creditNotes CreditNote[]
  creditNoteLines CreditNoteLine[]

  @@map("organizations")
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique
  name          String?
  passwordHash  String?   @map("password_hash")
  emailVerified DateTime? @map("email_verified") @db.Timestamptz(6)
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @default(now()) @map("updated_at") @db.Timestamptz(6)

  memberships  Membership[]
  sessions     Session[]
  authAccounts AuthAccount[]

  @@map("users")
}

/// Roles are per-organization, never global — see security-tenancy.md.
model Membership {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  role           MembershipRole
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @default(now()) @map("updated_at") @db.Timestamptz(6)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId, role])
  @@map("memberships")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime @db.Timestamptz(6)
  // Sliding renewal moves `expires` forward on use. `createdAt` is the anchor
  // for the ABSOLUTE ceiling, which renewal may never cross — without it a
  // session that is merely touched often enough would live for ever.
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
  @@map("sessions")
}

/// Auth.js calls this model "Account". That name is already taken by the
/// ledger's chart of accounts, so the OAuth-provider link is AuthAccount.
model AuthAccount {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refreshToken      String? @map("refresh_token")
  accessToken       String? @map("access_token")
  expiresAt         Int?    @map("expires_at")
  tokenType         String? @map("token_type")
  scope             String?
  idToken           String? @map("id_token")
  sessionState      String? @map("session_state")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("auth_accounts")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamptz(6)

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ── Rate limiting and security events (AUTH-TENANCY) ────────────────
// Strategy decided by independent review: Postgres-backed fixed window,
// limited on both source address and account, progressive delay rather
// than lockout, failing open. See B-20260911-06.

/// One fixed-window counter. `key` encodes action, dimension and value,
/// e.g. "signin:ip:203.0.113.7" or "signin:account:a@b.test".
model RateLimit {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  count       Int
  windowStart DateTime @map("window_start") @db.Timestamptz(6)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(6)

  @@index([expiresAt])
  @@map("rate_limits")
}

/// Separate from audit_logs on purpose: that table requires a non-null
/// organization_id and actor_id, and a failed sign-in usually has neither.
model SecurityEvent {
  id        String   @id @default(uuid()) @db.Uuid
  eventType String   @map("event_type")
  ip        String?
  email     String?
  detail    String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([eventType, createdAt])
  @@index([email, createdAt])
  @@map("security_events")
}

// ── Sales / A/R module ──────────────────────────────────────────────────
// Migrated via 20260913130000_add_sales_ar.

enum SalesCustomerPaymentMethod {
  WIRE
  CHECK
  CREDIT_CARD
  CASH
  ONLINE
  CONNECTOR
}

enum SalesInvoiceStatus {
  DRAFT
  SENT
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum SalesCreditNoteStatus {
  DRAFT
  ISSUED
  APPLIED
  EXPIRED
}

model SalesInvoiceCounter {
  organizationId String @id @map("organization_id") @db.Uuid
  lastNumber     Int    @map("last_number") @default(0)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@map("sales_invoice_counters")
}

model SalesPaymentCounter {
  organizationId String @id @map("organization_id") @db.Uuid
  lastNumber     Int    @map("last_number") @default(0)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@map("sales_payment_counters")
}

model SalesCreditNoteCounter {
  organizationId String @id @map("organization_id") @db.Uuid
  lastNumber     Int    @map("last_number") @default(0)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@map("sales_credit_note_counters")
}

model Customer {
  id              String                  @id @default(uuid()) @db.Uuid
  organizationId  String                  @map("organization_id") @db.Uuid
  name            String
  email           String?                 @db.VarChar(320)
  phone           String?                 @db.VarChar(50)
  billingAddress  Json?                   @map("billing_address")
  taxId           String?                 @map("tax_id") @db.VarChar(50)
  currency        String                  @db.Char(3) @default("USD")
  accountNumber   String?                 @map("account_number") @db.VarChar(100)
  paymentTerms    Int?                    @map("payment_terms") @default(30)
  isActive        Boolean                 @default(true) @map("is_active")
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                @updatedAt @default(now()) @map("updated_at") @db.Timestamptz(6)

  invoices        Invoice[]
  customerPayments CustomerPayment[]
  creditNotes     CreditNote[]

  @@unique([organizationId, email])
  @@unique([organizationId, accountNumber])
  @@index([organizationId, isActive])
  @@map("customers")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
}

model Invoice {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  customerId     String            @map("customer_id") @db.Uuid
  invoiceNumber  Int?              @map("invoice_number")
  issueDate      DateTime          @map("issue_date") @db.Date
  dueDate        DateTime          @map("due_date") @db.Date
  currency       String            @db.Char(3)
  fxRate         Decimal           @default(1) @map("fx_rate") @db.Decimal(18, 8)
  status         SalesInvoiceStatus @default(DRAFT)
  subtotal       Decimal           @default(0) @map("subtotal") @db.Decimal(18, 4)
  taxAmount      Decimal           @default(0) @map("tax_amount") @db.Decimal(18, 4)
  totalAmount    Decimal           @default(0) @map("total_amount") @db.Decimal(18, 4)
  amountPaid     Decimal           @default(0) @map("amount_paid") @db.Decimal(18, 4)
  amountDue      Decimal           @default(0) @map("amount_due") @db.Decimal(18, 4)
  memo           String?
  notes          String?
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @default(now()) @map("updated_at") @db.Timestamptz(6)

  invoiceLines  InvoiceLine[]
  customer      Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerPayments CustomerPayment[]
  paymentAllocations PaymentAllocation[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, customerId])
  @@index([organizationId, status])
  @@index([organizationId, dueDate])
  @@map("invoices")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
}

model InvoiceLine {
  id            String   @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  invoiceId     String   @map("invoice_id") @db.Uuid
  lineNumber    Int      @map("line_number")
  description   String
  accountId     String   @map("account_id") @db.Uuid
  quantity      Decimal  @default(0) @map("quantity") @db.Decimal(18, 4)
  unitPrice     Decimal  @default(0) @map("unit_price") @db.Decimal(18, 4)
  taxRate       Decimal  @default(0) @map("tax_rate") @db.Decimal(18, 4)
  taxAmount     Decimal  @default(0) @map("tax_amount") @db.Decimal(18, 4)
  lineTotal     Decimal  @default(0) @map("line_total") @db.Decimal(18, 4)

  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  account       Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([invoiceId, lineNumber])
  @@map("invoice_lines")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
}

model CustomerPayment {
  id             String                  @id @default(uuid()) @db.Uuid
  organizationId String                  @map("organization_id") @db.Uuid
  customerId     String                  @map("customer_id") @db.Uuid
  invoiceId      String?                 @map("invoice_id") @db.Uuid
  paymentNumber  Int?                    @map("payment_number")
  paymentDate    DateTime                @map("payment_date") @db.Date
  amount         Decimal                 @default(0) @db.Decimal(18, 4)
  currency       String                  @db.Char(3)
  fxRate         Decimal                 @default(1) @map("fx_rate") @db.Decimal(18, 8)
  method         SalesCustomerPaymentMethod
  reference      String?
  memo           String?
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                @updatedAt @default(now()) @map("updated_at") @db.Timestamptz(6)

  customer       Customer                @relation(fields: [customerId], references: [id], onDelete: Restrict)
  invoice        Invoice?                @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  paymentAllocations PaymentAllocation[]

  @@index([organizationId, customerId])
  @@index([organizationId, paymentDate])
  @@map("customer_payments")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
}

model PaymentAllocation {
  id                 String            @id @default(uuid()) @db.Uuid
  organizationId     String            @map("organization_id") @db.Uuid
  customerPaymentId  String            @map("customer_payment_id") @db.Uuid
  invoiceId          String            @map("invoice_id") @db.Uuid
  amount             Decimal           @default(0) @db.Decimal(18, 4)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  customerPayment    CustomerPayment   @relation(fields: [customerPaymentId], references: [id], onDelete: Restrict)
  invoice            Invoice           @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([customerPaymentId, invoiceId])
  @@map("payment_allocations")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
}

model CreditNote {
  id               String              @id @default(uuid()) @db.Uuid
  organizationId   String              @map("organization_id") @db.Uuid
  customerId       String              @map("customer_id") @db.Uuid
  creditNoteNumber Int?                @map("credit_note_number")
  issueDate        DateTime            @map("issue_date") @db.Date
  currency         String              @db.Char(3)
  totalAmount      Decimal             @default(0) @db.Decimal(18, 4)
  remainingAmount  Decimal             @default(0) @db.Decimal(18, 4)
  reason           String?
  memo             String?
  status           SalesCreditNoteStatus @default(DRAFT)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime            @updatedAt @default(now()) @map("updated_at") @db.Timestamptz(6)

  creditNoteLines  CreditNoteLine[]
  customer         Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@unique([organizationId, creditNoteNumber])
  @@index([organizationId, customerId])
  @@index([organizationId, status])
  @@map("credit_notes")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
}

model CreditNoteLine {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  creditNoteId   String    @map("credit_note_id") @db.Uuid
  lineNumber     Int       @map("line_number")
  description    String
  accountId      String    @map("account_id") @db.Uuid
  quantity       Decimal   @default(0) @db.Decimal(18, 4)
  unitPrice      Decimal   @default(0) @db.Decimal(18, 4)
  lineTotal      Decimal   @default(0) @db.Decimal(18, 4)

  creditNote     CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  account        Account    @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([creditNoteId, lineNumber])
  @@map("credit_note_lines")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
}
