    "@types/react-dom": "^19",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.9.6",
    "prisma": "^6.1",
    "tsx": "^4.19",
    "typescript": "^5.7",
    "typescript-eslint": "^8.19.0",
    "vitest": "^2.1"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.1",
    "next": "^15.1.6",
