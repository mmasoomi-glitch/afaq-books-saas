# Copy to .env and fill in. Never commit the result — .gitignore covers it.

DATABASE_URL="postgresql://user:password@localhost:5432/afaq_dev"
TEST_DATABASE_URL="postgresql://user:password@localhost:5432/afaq_test"

# The exact scheme + host + port browsers will send as `Origin`.
#
# When set, mutating auth requests whose Origin does not match EXACTLY are
# refused. The comparison is equality, never a suffix or substring check, so
# "https://books.example.com" must be written in full — a value of
# "books.example.com" would match nothing and refuse every sign-in.
#
# Leave it unset in development. Unset means the check does not run, which is
# the honest behaviour: a wrong expected origin refuses all legitimate traffic
# while looking like a control that works.
APP_ORIGIN=""

# Whether `x-forwarded-for` may be believed. Set to "true" ONLY when a proxy
# you control sits in front and OVERWRITES the header rather than appending to
# it.
#
# This is not a performance knob. The per-address rate limiter keys its counter
# on whatever this produces, and the header is client-controlled unless a proxy
# overwrites it — so setting this without a trusted proxy gives an attacker a
# fresh counter on every request and an unlimited budget of password guesses,
# against a limiter that still appears to be working.
#
# Unset means no source address is recorded. That is weaker and it is safe: the
# per-account limiter still applies, which is the dimension that stops one
# account being ground down from many machines.
TRUST_PROXY_HEADERS="false"

# Shared secret for POST /api/maintenance/reap, which an external scheduler
# calls to remove expired rate-limit counters.
#
# Generate with: openssl rand -base64 32
#
# UNSET MEANS THE ENDPOINT REFUSES EVERYTHING. That is deliberate -- an
# unauthenticated maintenance route is worse than no maintenance -- but it also
# means expired rows accumulate silently, so the server logs a warning on every
# refused call. Check for it if the table is growing.
#
# The endpoint answers 404 for both a missing secret and a wrong one, so an
# attacker cannot learn whether this deployment has maintenance configured.
#
# Must be at least 32 characters after trimming. Shorter, blank or
# whitespace-only values are treated as unset -- nothing rate-limits this
# route, so a short secret can be guessed at whatever speed the network
# allows. Generate one with:  openssl rand -base64 32
#
# It is compared EXACTLY. A trailing space here will refuse a caller that
# sends the trimmed value; the server logs a warning if it finds one.
MAINTENANCE_SECRET=""
